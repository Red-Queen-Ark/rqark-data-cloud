# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS builder

ARG VERSION=dev

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X gitea.carhyme.top/RedQueenArk/rqark-data-cloud/internal/version.Version=${VERSION}" -o /out/server ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/createsuperuser ./cmd/createsuperuser
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/backfill-provider-models ./cmd/backfill-provider-models

FROM alpine:3.21

RUN adduser -D -u 10001 app

COPY --from=builder /out/server /usr/local/bin/server
COPY --from=builder /out/createsuperuser /usr/local/bin/createsuperuser
COPY --from=builder /out/backfill-provider-models /usr/local/bin/backfill-provider-models

USER app

EXPOSE 7302

ENTRYPOINT ["server"]
