PROJECT_NAME=rqark-data-cloud

# SERVER
PORT=7302

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Redis
REDIS_SERVER=localhost
REDIS_PORT=6379

# Auth
SECRET_KEY=4154ff1a0be07314de746b621fcec99b9ee69b2112099e2b8a5c62d2b2c2cb23
# Whether anyone may create an account through /api/auth/register. Kept off by
# default: this deployment is internal, so an admin makes the accounts.
ALLOW_SELF_REGISTRATION=false

# Tasks
# How late an "at" task may still be dispatched, in seconds.
TASK_AT_GRACE=300

# Internal (the agent cloud's claim and finalize calls)
INTERNAL_TOKEN=0a3be1ef5e090053bf78701be8c0fefdc955e5e878d26eed3ed1e26a0f5e9080
TASK_RUN_TIMEOUT=600
TASK_RUN_TOKEN_BUFFER=120
TASK_RUN_STALE_AFTER=720
